ANTHROPIC_API_KEY=your-api-key-here

# Comma-separated origins allowed to call the chat API (e.g. https://yourdomain.com)
# Leave empty to allow all origins. In production, set this to your domain.
ALLOWED_CHAT_ORIGINS=

# ── Scheduling (/book) ──────────────────────────────────────────────
# Neon Postgres connection string (apply db/schema.sql once before first use).
DATABASE_URL=
# Resend API key + the address that receives booking notifications.
RESEND_API_KEY=
OWNER_EMAIL=
# Owner timezone for availability windows (IANA), e.g. America/New_York.
OWNER_TIMEZONE=America/New_York
# Comma-separated origins allowed to POST bookings. Empty = allow all.
SCHEDULE_ALLOWED_ORIGINS=

# Google two-way sync (optional). When BOTH are set, availability reads your
# calendar's free/busy and confirmed bookings are written as events.
# Service account JSON key, base64-encoded (or raw JSON). Share your calendar
# with the service account email and grant "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_JSON=
# The calendar to read/write — your Google account email.
GOOGLE_CALENDAR_ID=
